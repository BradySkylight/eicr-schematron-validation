         <axsl:when test="//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.4'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.2'] or //cda:organizer/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.35'] or //cda:manufacturedProduct/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.36'] or //cda:substanceAdministration/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.46'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']"/>
         <axsl:otherwise>
            <axsl:element name="validationResult">
               <axsl:element name="issue">
                  <axsl:attribute name="severity">fatals</axsl:attribute>
                  <axsl:element name="assertionID">Fatal-005</axsl:element>
                  <axsl:element name="flag"/>
                  <axsl:element name="message">Fatal Error (Missing Trigger Diagnosis, Result, Result Organizer, Lab Order, Medication Information, Immunization Medication Information, Planned Act, Planned Observation, Planned Procedure, Procedure Activity Act, Procedure Activity Observation, Procedure Activity Procedure, or Initiation Reason): An eICR must contain at least one of Initial Case Report Trigger Code Lab Test Order, Initial Case Report Trigger Code Problem Observation, Initial Case Report Trigger Code Result Observation, Initial Case Report Trigger Code Medication Information, Initial Case Report Trigger Code Result Organizer, Initial Case Report Trigger Code Immunization Medication Information, Initial Case Report Trigger Code Planned Act, Initial Case Report Trigger Code Planned Observation, Initial Case Report Trigger Code Planned Procedure, Initial Case Report Trigger Code Procedure Activity Act, Initial Case Report Trigger Code Procedure Activity Observation, Initial Case Report Trigger Code Procedure Activity Procedure, or Initial Case Report Initiation Reason Observation. (Rule: validate_one_trigger_presence)</axsl:element>
                  <axsl:element name="context">
                     <axsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </axsl:element>
                  <axsl:element name="test">//cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.4'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.3'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.2'] or //cda:organizer/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.35'] or //cda:manufacturedProduct/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.36'] or //cda:substanceAdministration/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.38'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.41'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.42'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.43'] or //cda:procedure/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.44'] or //cda:act/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.45'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.46'] or //cda:observation/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2.3.5']</axsl:element>
                  <axsl:element name="specification"/>
               </axsl:element>
            </axsl:element>
         </axsl:otherwise>
      </axsl:choose>
