   <axsl:template match="/" priority="3999" mode="M96">
      <axsl:choose>
         <axsl:when test="count(cda:ClinicalDocument/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2'][@extension = '2022-05-01']) = 1"/>
         <axsl:otherwise>
            <axsl:element name="validationResult">
               <axsl:element name="issue">
                  <axsl:attribute name="severity">fatals</axsl:attribute>
                  <axsl:element name="assertionID">Fatal-001</axsl:element>
                  <axsl:element name="flag"/>
                  <axsl:element name="message">Fatal: SHALL contain exactly one [1..1] templateId (CONF:4482-96) such that it SHALL contain exactly one [1..1] @root="2.16.840.1.113883.10.20.15.2" eICR Initial Public Health Case Report Document (CONF:4482-95). SHALL contain exactly one [1..1] @extension="2022-05-01" (CONF:4482-96).</axsl:element>
                  <axsl:element name="context">
                     <axsl:apply-templates select="." mode="schematron-get-full-path"/>
                  </axsl:element>
                  <axsl:element name="test">count(cda:ClinicalDocument/cda:templateId[@root = '2.16.840.1.113883.10.20.15.2'][@extension = '2022-05-01']) = 1</axsl:element>
                  <axsl:element name="specification"/>
               </axsl:element>
            </axsl:element>
         </axsl:otherwise>
      </axsl:choose>
